{
  "model_name": "requirements_verification",
  "description": "Audit current-condition safe-first routing, coolest fallback, independent arrival bound, and implemented actuator response.",
  "enabled": true,
  "property_target": "edge",
  "output_properties": [
    "verification_route_selection_valid",
    "verification_bounded_arrival_valid",
    "verification_fallback_valid",
    "verification_actuator_response_valid",
    "verification_overall_valid"
  ],
  "input_properties": [
    "utci_c", "unsafe_heat", "heat_exposure_rate", "air_temp_f", "humidity_pct", "mist_cooling_f"
  ],
  "parameters": {
    "maximum_arrival_ratio": 2.5,
    "comparison_tolerance": 0.000001
  },
  "metadata": {
    "formula_file": "formula.mls",
    "formula_name": "safe_to_destination"
  }
}
